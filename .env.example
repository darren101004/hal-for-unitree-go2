# ================================
# Server (src/server.py)
# ================================
PORT=8001
UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=10

# ================================
# Logging (src/mcps/configs.py)
# ================================
ENV=local
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOGS_DIR=./logs

# ================================
# State service (src/dependencies/__init__.py)
# Topics are written in ROS2 form; the service maps them to DDS form (adds the "rt/" prefix).
# ================================
STATE_TOPIC=/lf/sportmodestate
STATE_LOWSTATE_TOPIC=/lowstate
# STATE_LOWSTATE_MIN_UPDATE_INTERVAL_SEC=120.0

# Ethernet interface connected to the robot.
# On the OrangePi board this is "end0" (Allwinner dwmac-sunxi driver).
# It is NOT "eth0" or "enp2s0" as the Unitree docs assume.
# Used by BOTH the sport service and the state service.
STATE_NETWORK_INTERFACE=end0

# ================================
# Device Watcher (auto-recovery)
# Restarts the sport/state services when the robot boots after the server.
# ================================
# DEVICE_WATCHER_ENABLED=true
# DEVICE_WATCHER_POLL_INTERVAL=5.0
# DEVICE_WATCHER_BASE_BACKOFF=2.0
# DEVICE_WATCHER_MAX_BACKOFF=120.0
# DEVICE_WATCHER_MAX_RETRIES=5
# DEVICE_WATCHER_INITIAL_GRACE_PERIOD=10.0
