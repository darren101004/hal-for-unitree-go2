# ================================
# Server (server.py)
# ================================
PORT=8001
UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=10

# ================================
# Logging (mcps/configs.py)
# ================================
ENV=local
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOGS_DIR=./logs

# ================================
# State service (dependencies/__init__.py)
# ================================
STATE_SERVICE_MODE=ros2
STATE_TOPIC=/lf/sportmodestate
STATE_NETWORK_INTERFACE=eth0

# ================================
# Cameras
# ================================
CAMERA_FPS=6
DEPTH_CAMERA_FPS=6
# DEPTH_CAMERA_DESCRIPTION_MAX_CONCURRENCY=2
LOCAL_CAMERA_DEVICE_ID=10
DEFAULT_REMOTE_DETECTOR_URL=https://956x9guslla3pa-64411556-8888.proxy.runpod.net/api/dl/yoloworld
DL_API_KEY=

# ================================
# Speaker / TTS
# ================================
SPEAKER_DEVICE_ID=UACDemoV10
SPEAKER_TTS_ENGINE=openai
SPEAKER_SAMPLE_RATE=48000
SPEAKER_BLOCK_SIZE=1024
SPEAKER_CHANNELS=1
OPENAI_API_KEY=
OPENAI_BASE_URL=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
DEFAULT_PIPER_MODEL=en_US-lessac-medium.onnx
SPEAKER_AUDIO_DIR=resources/sound/dog
# SPEAKER_CHUNK_WRITE_TIMEOUT=10.0
# SPEAKER_LOCK_ACQUIRE_TIMEOUT=5.0
# SPEAKER_VOLUME=1.0                  # Master volume 0.0-2.0
# SPEAKER_VOLUME_RATE=3.0             # TTS audio amplification before resampling
# SPEAKER_MIXER_VOLUME=100            # ALSA mixer volume 0-100 (set via amixer on init)
# SPEAKER_FADE_IN_MS=0                # Fade-in duration ms (prevents power spike on weak supplies)
# SPEAKER_STARTUP_DELAY_MS=0          # Delay ms before first write (gives device time to stabilize)

# ================================
# TTS streaming
# ================================
# TTS_SPEED=1.5
# TTS_CHUNK_SIZE=2048

# ================================
# Audio capture (voice commands)
# ================================
AUDIO_CAPTURE_DEVICE_ID=respeaker
AUDIO_CAPTURE_ENGINE=deepgram
AUDIO_CAPTURE_HOTWORDS=["hey doggy","hey doggi","hi doggy","hi doggi", "hi docgi", "hey docgi", "hey docgy", "hi docgy"]
AUDIO_CAPTURE_PATIENCE=3
VOSK_MODEL_ID=vosk-model-small-en-us-0.15
DEEPGRAM_MODEL_ID=flux-general-en
AUDIO_CAPTURE_SAMPLE_RATE=16000
AUDIO_CAPTURE_CHANNELS=1
# AUDIO_CAPTURE_SILENCE_THRESHOLD=0.01
# AUDIO_CAPTURE_CLIENT_DENOISE=false
DEEPGRAM_API_KEY=
# AUDIO_TRANSCRIBE_MAX_CONCURRENCY=2

# ================================
# Device Watcher (auto-recovery)
# ================================
# DEVICE_WATCHER_ENABLED=true
# DEVICE_WATCHER_POLL_INTERVAL=5.0
# DEVICE_WATCHER_BASE_BACKOFF=2.0
# DEVICE_WATCHER_MAX_BACKOFF=120.0
# DEVICE_WATCHER_MAX_RETRIES=5
# DEVICE_WATCHER_INITIAL_GRACE_PERIOD=10.0
